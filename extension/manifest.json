{
  "manifest_version": 3,
  "name": "HawkApply",
  "version": "1.1.0",
  "description": "H1B match scores and job tracking — right on the job page.",

  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://*/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "HawkApply"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://linkedin.com/jobs/*",
        "https://*.greenhouse.io/*/jobs/*",
        "https://boards.greenhouse.io/*",
        "https://jobs.lever.co/*/*",
        "https://*.workday.com/*/job/*",
        "https://*.myworkdayjobs.com/*/job/*",
        "https://*.ashbyhq.com/*/jobs/*",
        "https://*.smartrecruiters.com/*/posting/*",
        "https://*.jobvite.com/*/job/*",
        "https://amazon.jobs/en/jobs/*",
        "https://www.amazon.jobs/en/jobs/*",
        "https://careers.google.com/jobs/*",
        "https://www.metacareers.com/jobs/*",
        "https://careers.microsoft.com/us/en/job/*",
        "https://jobs.apple.com/en-us/details/*",
        "https://*.icims.com/jobs/*",
        "https://*.taleo.net/careersection/*",
        "https://*.brassring.com/TGnewUI/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],

  "options_page": "options.html",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
